{
  "rules": {
    ".read": false,
    ".write": false,
    "musicV1": {
      "profiles": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['displayName','messageId','messageLookupKey','createdAt'])",
          "displayName": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 30"
          },
          "messageId": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Z2-9]{16}$/)"
          },
          "messageLookupKey": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{64}$/) && newData.parent().parent().parent().child('messageLookup').child(newData.val()).val() == auth.uid"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() == now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "admins": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": false
        }
      },
      "messageLookup": {
        "$key": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.isString() && newData.val() == auth.uid && newData.parent().parent().child('profiles').child(auth.uid).child('messageLookupKey').val() == $key",
          ".validate": "$key.matches(/^[a-f0-9]{64}$/)"
        }
      },
      "mailboxes": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".indexOn": [
            "createdAt"
          ],
          "$id": {
            ".write": "auth != null && ((!newData.exists() && $uid == auth.uid) || (!data.exists() && newData.exists() && newData.child('fromUid').val() == auth.uid && ($uid == auth.uid || $uid == newData.child('toUid').val()) && root.child('musicV1/profiles').child(auth.uid).exists() && root.child('musicV1/messageLookup').child(newData.child('recipientKey').val()).val() == newData.child('toUid').val() && newData.child('toUid').val() != auth.uid))",
            ".validate": "$id.matches(/^[-A-Za-z0-9_]{20}$/) && newData.hasChildren(['fromUid','fromName','fromMessageId','toUid','toName','recipientKey','body','createdAt'])",
            "fromUid": {
              ".validate": "newData.isString() && newData.val() == auth.uid"
            },
            "fromName": {
              ".validate": "newData.isString() && newData.val() == root.child('musicV1/profiles').child(auth.uid).child('displayName').val()"
            },
            "fromMessageId": {
              ".validate": "newData.isString() && newData.val() == root.child('musicV1/profiles').child(auth.uid).child('messageId').val()"
            },
            "toUid": {
              ".validate": "newData.isString() && root.child('musicV1/profiles').child(newData.val()).exists()"
            },
            "toName": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 30"
            },
            "recipientKey": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{64}$/)"
            },
            "body": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && newData.val() == now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "songEdits": {
        ".read": true,
        "$id": {
          ".write": "auth != null && root.child('musicV1/admins').child(auth.uid).val() == true && newData.exists()",
          ".validate": "$id.matches(/^[a-z0-9]+(-[a-z0-9]+)*$/) && $id.length <= 100 && newData.hasChildren(['content','previousContent','revision','updatedBy','updatedAt'])",
          "content": {
            ".validate": "newData.isString() && newData.val().length <= 200000"
          },
          "previousContent": {
            ".validate": "newData.isString() && newData.val().length <= 200000"
          },
          "revision": {
            ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)"
          },
          "updatedBy": {
            ".validate": "newData.isString() && newData.val() == auth.uid"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() == now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
